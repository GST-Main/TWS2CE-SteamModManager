<UserControl x:Class="TWS2CESteamModManager.App.Controls.ModsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:TWS2CESteamModManager.App.Localization">
    <UserControl.Resources>
        <Style x:Key="ModCellText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E9E8E3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="32,26,32,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{loc:Text label.installedMods}" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Summary}" Foreground="#929BA8" Margin="0,8,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,22,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Content="{loc:Text action.import}" Click="Import_Click" IsEnabled="{Binding CanManage}"/>
                <Button Content="{loc:Text action.moveUp}" Command="{Binding MoveUpCommand}" Margin="10,0,0,0"/>
                <Button Content="{loc:Text action.moveDown}" Command="{Binding MoveDownCommand}" Margin="10,0,0,0"/>
                <Button Content="{loc:Text action.delete}" Command="{Binding DeleteCommand}" Margin="10,0,0,0" BorderBrush="#75534D"
                        ToolTip="{loc:Text tip.deleteMod}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="{loc:Text action.folders}" Command="{Binding EditFoldersCommand}"/>
                <Button Content="{loc:Text action.reloadMods}" Command="{Binding ReloadCommand}" Margin="10,0,0,0"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="2" Background="#22252A" BorderBrush="#4C4540" BorderThickness="1" CornerRadius="9" Padding="20" Margin="0,0,0,18"
                Visibility="{Binding ShowFolderSetup, Converter={StaticResource BoolVisibility}}">
            <StackPanel>
                <TextBlock Text="{loc:Text label.gameFolders}" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="{loc:Text msg.confirmFolders}" Foreground="#A9B1BD" Margin="0,8,0,18"/>
                <Grid IsEnabled="{Binding CanConfigure}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="{loc:Text label.appDataFolder}" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Background="#171A1F" BorderBrush="#3F4550" BorderThickness="1" CornerRadius="5">
                        <TextBox Text="{Binding AppDataPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:Text a11y.appDataFolder}"/>
                    </Border>
                    <Button Grid.Column="2" Content="{loc:Text action.browseFolder}" Click="SelectAppData_Click" Margin="10,0,0,0"/>
                    <TextBlock Grid.Row="1" Text="{loc:Text label.gameInstallation}" VerticalAlignment="Center" Margin="0,12,0,0"/>
                    <Border Grid.Row="1" Grid.Column="1" Background="#171A1F" BorderBrush="#3F4550" BorderThickness="1" CornerRadius="5" Margin="0,12,0,0">
                        <TextBox Text="{Binding GameInstallPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:Text a11y.gameFolder}"/>
                    </Border>
                    <Button Grid.Row="1" Grid.Column="2" Content="{loc:Text action.browseFolder}" Click="SelectGame_Click" Margin="10,12,0,0"/>
                </Grid>
                <Button Content="{loc:Text action.saveFolders}" Command="{Binding ApplyFoldersCommand}" HorizontalAlignment="Left" Margin="135,18,0,0"/>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="3">
            <Border Background="#302820" BorderBrush="#6E5540" BorderThickness="1" CornerRadius="7" Padding="15" Margin="0,0,0,16"
                    Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}">
                <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="#DEC2A5"/>
            </Border>
            <ProgressBar Height="2" IsIndeterminate="True" Foreground="#D9B77B" Background="#25292F" Margin="0,0,0,14"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"/>
        </StackPanel>
        <Grid Grid.Row="4">
            <DataGrid x:Name="ModsGrid" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedMod, Mode=TwoWay}"
                      AllowDrop="True" PreviewDragOver="ModsGrid_DragOver" PreviewDrop="ModsGrid_Drop" PreviewDragLeave="ModsGrid_DragLeave"
                      IsEnabled="{Binding CanManage}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserSortColumns="False" CanUserReorderColumns="False" SelectionMode="Single" SelectionUnit="FullRow"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#34373E"
                      Background="#191C21" Foreground="#E9E8E3" BorderBrush="#34373E" BorderThickness="1" RowHeight="65">
                <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#282C33"/><Setter Property="Foreground" Value="#B6BFCC"/>
                    <Setter Property="Padding" Value="12,13"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="BorderBrush" Value="#41464F"/><Setter Property="FontWeight" Value="SemiBold"/>
                </Style></DataGrid.ColumnHeaderStyle>
                <DataGrid.RowStyle><Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="#202329"/><Setter Property="Foreground" Value="#ECEAE4"/>
                    <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#3A342C"/></Trigger></Style.Triggers>
                </Style></DataGrid.RowStyle>
                <DataGrid.CellStyle><Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="12,0"/><Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border>
                    </ControlTemplate></Setter.Value></Setter>
                </Style></DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="50" CanUserResize="False">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                            <Border Width="26" Height="40" Background="Transparent" Cursor="SizeAll" ToolTip="{loc:Text tip.dragOrder}"
                                    PreviewMouseLeftButtonDown="DragHandle_MouseDown" PreviewMouseMove="DragHandle_MouseMove"
                                    PreviewMouseLeftButtonUp="DragHandle_MouseUp"
                                    QueryContinueDrag="DragHandle_QueryContinueDrag" AutomationProperties.Name="{loc:Text a11y.dragMod}">
                                <TextBlock Text="⠿" FontSize="24" Foreground="#A39A88" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{loc:Text label.enabled}" Width="85">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                            <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}"/>
                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{loc:Text label.order}" Binding="{Binding Order}" Width="75" ElementStyle="{StaticResource ModCellText}"/>
                    <DataGridTemplateColumn Header="{loc:Text label.name}" Width="*" MinWidth="230">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Grid Width="40" Height="40" Background="#171A1F" HorizontalAlignment="Left">
                                    <Image Source="{Binding Image}" Stretch="Uniform"/>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" ToolTip="{Binding FileName}">
                                    <Button Click="ModName_Click" Tag="{Binding}" HorizontalAlignment="Left" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=StackPanel}}"
                                            Padding="0" ToolTip="{loc:Text tip.viewModDetails}" AutomationProperties.Name="{Binding Name}">
                                        <Button.Template><ControlTemplate TargetType="Button"><ContentPresenter/></ControlTemplate></Button.Template>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Foreground="#E7C68F"/>
                                    </Button>
                                    <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" Foreground="#929BA8" FontSize="11" Margin="0,5,0,0"
                                               Visibility="{Binding HasDisplayName, Converter={StaticResource BoolVisibility}}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{loc:Text label.source}" Binding="{Binding Source}" Width="125" ElementStyle="{StaticResource ModCellText}"/>
                    <DataGridTemplateColumn Header="{loc:Text label.status}" Width="135">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                            <TextBlock Text="{Binding Status}"><TextBlock.Style><Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#A8C3A2"/>
                                <Style.Triggers><DataTrigger Binding="{Binding IsMissing}" Value="True"><Setter Property="Foreground" Value="#DBA48B"/></DataTrigger></Style.Triggers>
                            </Style></TextBlock.Style></TextBlock>
                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}">
                <TextBlock Text="{loc:Text label.noMods}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="{loc:Text msg.importOrDownload}" Foreground="#A0A9B6" Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>
        <TextBlock Grid.Row="5" Text="{loc:Text msg.scriptOrder}"
                   Foreground="#8C96A5" FontSize="12" Margin="0,16,0,0"/>
    </Grid>
</UserControl>

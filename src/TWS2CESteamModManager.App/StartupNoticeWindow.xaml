<Window x:Class="TWS2CESteamModManager.App.StartupNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:TWS2CESteamModManager.App.Localization"
        Title="{loc:Text notice.title}" Icon="Assets/App.ico" Width="660" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}"
        Foreground="#E9E8E3" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True"
        KeyboardNavigation.TabNavigation="Cycle">
    <Border Padding="32" Background="{StaticResource BackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer x:Name="NoticeScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock Text="{loc:Text notice.title}" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{loc:Text notice.subtitle}" Foreground="#D9B77B" Margin="0,8,0,24"/>
            <Border Background="#302820" BorderBrush="#6E5540" BorderThickness="1" CornerRadius="8" Padding="16">
                <TextBlock Text="{loc:Text notice.compatibility}"
                           TextWrapping="Wrap" LineHeight="23" Foreground="#E4C99F"/>
            </Border>
            <TextBlock Text="{loc:Text notice.risks}"
                       TextWrapping="Wrap" LineHeight="23" Margin="0,20,0,0"/>
            <TextBlock Text="{loc:Text notice.recovery}"
                       TextWrapping="Wrap" LineHeight="23" Margin="0,14,0,0"/>
            <TextBlock Text="{loc:Text notice.responsibility}"
                       TextWrapping="Wrap" LineHeight="23" Margin="0,14,0,24"/>
            <CheckBox x:Name="DoNotShowAgain" Content="{loc:Text notice.doNotShowAgain}" Foreground="#C2C5CB" VerticalContentAlignment="Center"
                      AutomationProperties.Name="{loc:Text notice.doNotShowAgain}"/>
            <TextBlock x:Name="PreferenceError" Visibility="Collapsed" Foreground="#E4B2A5" TextWrapping="Wrap" LineHeight="21" Margin="0,16,0,0"
                       AutomationProperties.LiveSetting="Assertive"/>
        </StackPanel>
        </ScrollViewer>
            <Border Grid.Row="1" BorderBrush="#34373E" BorderThickness="0,1,0,0" Margin="0,24,0,0" Padding="0,20,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="DeclineButton" Content="{loc:Text notice.decline}" Click="Decline_Click" IsCancel="True" MinWidth="130"/>
                    <Button x:Name="AgreeButton" Content="{loc:Text notice.agree}" Click="Agree_Click" MinWidth="130" Margin="12,0,0,0"
                            Background="#3A342A" BorderBrush="#D9B77B"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>

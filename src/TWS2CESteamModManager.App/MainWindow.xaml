<Window x:Class="TWS2CESteamModManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:TWS2CESteamModManager.App.Localization"
        xmlns:controls="clr-namespace:TWS2CESteamModManager.App.Controls"
        Title="{loc:Text app.title}" Icon="Assets/App.ico" Width="1440" Height="960" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}"
        Foreground="#E9E8E3" FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <DataTemplate x:Key="WorkshopCard">
            <Button Click="WorkshopItem_Click" Tag="{Binding}" Padding="0" Cursor="Hand" ToolTip="{loc:Text tip.viewItemDetails}"
                    HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Title}">
                <Button.Template><ControlTemplate TargetType="Button"><ContentPresenter/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.85"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Button.Template>
            <Border Background="#22252A" BorderBrush="#35383F" BorderThickness="1" CornerRadius="11" Padding="10">
                <StackPanel>
                    <controls:SquarePreview>
                    <Grid ClipToBounds="True" Background="#171A1F">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="◇" FontSize="32" Foreground="#665B48" HorizontalAlignment="Center"/>
                            <TextBlock Text="{loc:Text label.previewUnavailable}" Foreground="#6E747F" FontSize="11" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                               AutomationProperties.Name="{loc:Text a11y.workshopPreview}"/>
                    </Grid>
                    </controls:SquarePreview>
                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" LineHeight="22"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Height="46" Margin="7,15,7,0" ToolTip="{Binding Title}"/>
                    <TextBlock Text="{Binding Author}" Foreground="#AAAEB5" Margin="7,4,7,12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Author}"/>
                    <ItemsControl ItemsSource="{Binding Tags}" Margin="7,0,0,12" MinHeight="27">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#30333A" CornerRadius="4" Padding="8,4" Margin="0,0,5,5">
                                    <TextBlock Text="{Binding}" Foreground="#B9BDC4" FontSize="11"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border BorderBrush="#3A3D43" BorderThickness="0,1,0,0" Padding="7,12,7,4">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding UpVotes}" Foreground="#9DBB9C" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding DownVotes}" Foreground="#C39187" Margin="14,0,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Rating}" Foreground="#A4A8AF" FontSize="11" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Button Content="{Binding DownloadLabel}" Command="{Binding DownloadCommand}" Margin="7,12,7,3"
                            ToolTip="{Binding DownloadHint}" ToolTipService.ShowOnDisabled="True" Click="DownloadButton_Click"/>
                </StackPanel>
            </Border>
            </Button>
        </DataTemplate>
        <Style x:Key="CategoryItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#ABB0BA"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="CategoryFrame" CornerRadius="6" Background="Transparent" Padding="12,10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CategoryFrame" Property="Background" Value="#26292E"/></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="CategoryFrame" Property="Background" Value="#3A3329"/>
                                <Setter Property="Foreground" Value="#E7C68F"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CategoryFrame" Property="BorderBrush" Value="#D9B77B"/><Setter TargetName="CategoryFrame" Property="BorderThickness" Value="1"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="RootLayout" Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="#191B1F" BorderBrush="#34373D" BorderThickness="0,0,0,1" Padding="24,12">
            <Border.Style><Style TargetType="Border"><Style.Triggers>
                <DataTrigger Binding="{Binding Browser.IsDetailOpen}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
            </Style.Triggers></Style></Border.Style>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Name="ModsTab" Content="{loc:Text tab.mods}" Command="{Binding ShowModsCommand}" MinWidth="100">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers>
                        <DataTrigger Binding="{Binding IsModsSelected}" Value="True"><Setter Property="Background" Value="#3A3329"/><Setter Property="BorderBrush" Value="#D9B77B"/></DataTrigger>
                    </Style.Triggers></Style></Button.Style>
                </Button>
                <Button x:Name="BrowseTab" Grid.Column="1" Content="{loc:Text tab.browse}" Command="{Binding ShowBrowseCommand}" MinWidth="100" Margin="10,0,0,0">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers>
                        <DataTrigger Binding="{Binding IsBrowseSelected}" Value="True"><Setter Property="Background" Value="#3A3329"/><Setter Property="BorderBrush" Value="#D9B77B"/></DataTrigger>
                    </Style.Triggers></Style></Button.Style>
                </Button>
                <TextBlock x:Name="LaunchErrorText" Grid.Column="2" Text="{Binding TopMessage}" Foreground="#E4B2A5" TextWrapping="Wrap"
                           HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="550" MaxHeight="56" TextTrimming="CharacterEllipsis" Margin="20,0"
                           ToolTip="{Binding TopMessage}"
                           AutomationProperties.LiveSetting="Assertive"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Text label.language}" Foreground="#A9B1BD" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="LanguageCombo" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                              Width="140" AutomationProperties.Name="{loc:Text label.language}"
                              ToolTip="{loc:Text msg.restartLanguage}">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}"/></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <Button x:Name="LaunchGameButton" Grid.Column="4" Content="{loc:Text action.launchGame}" Command="{Binding LaunchCommand}" MinWidth="110"
                        Background="#246BB3" BorderBrush="#5098DF" Foreground="White" ToolTip="{Binding LaunchHint}"
                        ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{loc:Text a11y.launchGame}"/>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Visibility="{Binding IsModsSelected, Converter={StaticResource BoolVisibility}}">
            <Grid.Style><Style TargetType="Grid"><Style.Triggers>
                <DataTrigger Binding="{Binding Browser.IsDetailOpen}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
            </Style.Triggers></Style></Grid.Style>
            <controls:ModsView x:Name="InstalledModsView" DataContext="{Binding Mods}"/>
        </Grid>
        <Grid x:Name="BrowserContent" Grid.Row="1" DataContext="{Binding Browser}"
              Visibility="{Binding DataContext.IsBrowseSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}">
        <Grid.Style><Style TargetType="Grid"><Style.Triggers>
            <DataTrigger Binding="{Binding IsDetailOpen}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
        </Style.Triggers></Style></Grid.Style>
        <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Background="#191B1F" BorderBrush="#303238" BorderThickness="0,0,1,0" Padding="18,28,18,22">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="{loc:Text branding.game}" FontSize="21" FontWeight="Bold" Margin="0,0,0,3"/>
                    <TextBlock Text="{loc:Text branding.edition}" FontSize="10" Foreground="#B3A085"/>
                    <Border Height="1" Background="#34373D" Margin="0,26,0,25"/>
                </StackPanel>
                <ListBox x:Name="CategoryList" Grid.Row="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                         SelectionMode="Single" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource CategoryItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{loc:Text a11y.workshopCategory}">
                    <ListBox.Template><ControlTemplate TargetType="ListBox">
                        <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate></ListBox.Template>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                <TextBlock Grid.Column="1" Text="{Binding CountText}" FontSize="11" Foreground="#858B95" Margin="6,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="2" Margin="10,18,10,0">
                    <TextBlock Text="{loc:Text status.loadingCategories}" Foreground="#9399A3" FontSize="11" Visibility="{Binding CategoriesLoading, Converter={StaticResource BoolVisibility}}"/>
                    <StackPanel Visibility="{Binding HasCategoryError, Converter={StaticResource BoolVisibility}}">
                        <TextBlock Text="{Binding CategoryError}" TextWrapping="Wrap" Foreground="#C7AB8F" FontSize="11"/>
                        <Button Content="{loc:Text action.retryCategories}" Command="{Binding RetryCategoriesCommand}" Margin="0,10,0,0" Padding="8,7"/>
                    </StackPanel>
                    <TextBlock Text="{loc:Text branding.manager}" Foreground="#676E79" FontSize="9" Margin="0,18,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="32,29,32,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
                <Border Background="#202329" BorderBrush="#3C414A" BorderThickness="1" CornerRadius="7">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="⌕" FontSize="25" Foreground="#A2A9B1" VerticalAlignment="Center" Margin="14,0,0,3"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{loc:Text a11y.searchWorkshop}" ToolTip="{loc:Text tip.search}">
                            <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchCommand}"/></TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Grid.Column="1" Text="{loc:Text tip.searchPlaceholder}" Foreground="#717986" IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding SearchText}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Grid.Column="2" Command="{Binding SearchCommand}" Margin="5" Padding="15,5" Background="#D9B77B" BorderBrush="#D9B77B">
                            <TextBlock Text="{loc:Text action.search}" Foreground="#242019"/>
                        </Button>
                    </Grid>
                </Border>
                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Text label.sort}" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#A3A9B2"/>
                    <ComboBox x:Name="SortCombo" Grid.Column="1" ItemsSource="{Binding SortOptions}"
                              SelectedItem="{Binding SelectedSort, Mode=TwoWay}" AutomationProperties.Name="{loc:Text a11y.workshopSort}">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </Grid>
            <Grid Grid.Row="1" Margin="0,0,0,18">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Heading}" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ResultSummary}" Foreground="#929BA8" FontSize="12" Margin="0,7,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="{loc:Text action.refresh}" Command="{Binding RefreshCommand}" VerticalAlignment="Center" Padding="12,8"/>
            </Grid>
            <ProgressBar Grid.Row="2" Height="2" IsIndeterminate="True" Foreground="#D9B77B" Background="#25292F"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,15"/>
            <Grid Grid.Row="3">
                <ScrollViewer x:Name="ResultsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
                    <ItemsControl x:Name="WorkshopItems" ItemsSource="{Binding Items}" ItemTemplate="{StaticResource WorkshopCard}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:WorkshopTilePanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="450"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}">
                    <TextBlock Text="{loc:Text label.noItems}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{loc:Text msg.tryAnotherSearch}" Foreground="#939CA9" Margin="0,12,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>
                <Border Background="#29251F" BorderBrush="#6E5540" BorderThickness="1" CornerRadius="10" Padding="25"
                        HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520"
                        Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}">
                    <StackPanel>
                        <TextBlock x:Name="WorkshopErrorHeading" Text="{Binding ErrorHeading}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Error}" Foreground="#C1B2A1" TextWrapping="Wrap" Margin="0,12,0,18"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="LaunchSteamButton" Content="{loc:Text action.launchSteam}" Command="{Binding LaunchSteamCommand}" Margin="0,0,10,0"
                                    Visibility="{Binding NeedsSteam, Converter={StaticResource BoolVisibility}}"/>
                            <Button Content="{loc:Text action.retry}" Command="{Binding RefreshCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
            <Border Grid.Row="4" BorderBrush="#34373D" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,15,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Text branding.workshop}" Foreground="#717A87" FontSize="10" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="{loc:Text action.previousPage}" Command="{Binding PreviousCommand}" Padding="12,8"/>
                        <TextBlock Text="{Binding PageText}" Foreground="#B2B7BF" Margin="17,0" VerticalAlignment="Center"/>
                        <Button Content="{loc:Text action.nextPage}" Command="{Binding NextCommand}" Padding="12,8"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        </Grid>
        <Border Grid.Row="2" DataContext="{Binding Mods}" Background="#2D2922" BorderBrush="#5A4B36" BorderThickness="0,1,0,0" Padding="24,14"
                Visibility="{Binding HasTransferStatus, Converter={StaticResource BoolVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="{Binding DownloadStatus}" TextWrapping="Wrap"/>
                    <ProgressBar Height="3" IsIndeterminate="True" Foreground="#D9B77B" Background="#413B31" Margin="0,10,0,0"
                                 Visibility="{Binding IsDownloading, Converter={StaticResource BoolVisibility}}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="{loc:Text action.cancelDownload}" Command="{Binding CancelDownloadCommand}"
                            Visibility="{Binding IsDownloading, Converter={StaticResource BoolVisibility}}"/>
                    <Button Content="{loc:Text action.dismiss}" Command="{Binding DismissTransferCommand}" Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid x:Name="DetailOverlay" Grid.RowSpan="3" Visibility="{Binding Browser.IsDetailOpen, Converter={StaticResource BoolVisibility}}" Panel.ZIndex="10">
            <Border Background="#B8000000" MouseDown="DetailBackdrop_MouseDown"/>
            <Border Background="#22252A" BorderBrush="#4A4C51" BorderThickness="1" CornerRadius="12" Padding="26"
                    Margin="36" MaxWidth="1000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <controls:WorkshopDetailView x:Name="DetailView" DataContext="{Binding Browser.Detail}"/>
            </Border>
        </Grid>
    </Grid>
</Window>
